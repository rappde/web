# Image source masters — kept locally, only used by `npm run optimize:images`.
# The optimised web assets in public/images are committed; the heavy masters are
# NOT (they would otherwise bloat the repo and get deployed from public/).
image-masters/

# MOSH_UNIT video/GIF source masters — heavy (~1.85 GB), local only, used by
# `npm run optimize:videos`. Only the optimised public/mosh/ outputs are committed.
media_moshunit/
